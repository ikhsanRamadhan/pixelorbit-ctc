# Deployer key for Creditcoin CC3 testnet and Sepolia. Funds every deploy
# transaction and becomes the contract owner. Keep it out of the app: this key
# is never read by Next.js.
DEPLOYER_PRIVATE_KEY=

# Sepolia RPC for the source deploy. Defaults to a public endpoint; set your
# own for reliability.
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Sepolia PixelOrbitSource, printed by deploy-sepolia-source.ts. Required by
# deploy-creditcoin.ts: the ASC checks it on every proof.
# SOURCE_ADDRESS=0x...

# BlockProver precompile override. Defaults to the real 0xFD2 address; set
# only for a local mock setup.
# BLOCK_PROVER_ADDRESS=0x0000000000000000000000000000000000000FD2

# Note: the ASC and price oracle link the vendored EvmV1Decoder library
# internally. There is no decoder contract address to configure; the former
# DECODER_ADDRESS plumbing was removed with the external-decoder live bug.

# Marketplace protocol fee, in basis points. Capped at 500 (5%) by the contract
# itself, and the cap is immutable — a seller's cut cannot be raised after they
# list. Defaults to 250 (2.5%) when unset.
MARKETPLACE_FEE_BIPS=250
# Where the cut goes. Defaults to the deployer address when unset.
# MARKETPLACE_FEE_RECIPIENT=0x...

# Stars token for single-contract deploys (deploy-ship.ts,
# deploy-marketplace.ts). Must be the OrbitStarsCC from deploy-creditcoin.ts.
# STARS_ADDRESS=0x...

# Sepolia Stars token for the Sepolia sale deploy (deploy-stars-sale.ts).
# Printed by deploy-sepolia-source.ts alongside PixelOrbitSource. Fail-fast
# when unset: deploying a sale against the wrong Stars token strands its
# inventory, so there is no silent default.
# STARS_SEPOLIA_ADDRESS=0x...
