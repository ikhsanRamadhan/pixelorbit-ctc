# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must ship so a fresh clone has something to copy.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI instruction files
AGENTS.md
CLAUDE.md

# AI tooling / agent state
.opencode/
graphify-out/
.tmpaudit/

# Working notes / internal docs (keep README.md only)
BOUNTY.md
IMPROVE-BOUNTY2.md
DEPLOY-DROP-*.md
# Agent working notes, internal docs, and pitch deck stay local, never ship.
.superpowers/
docs/
deck/