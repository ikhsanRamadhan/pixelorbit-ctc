# PixelOrbit — frontend environment
# Copy to .env.local and fill in NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID.
# Never commit .env.local (it is covered by .gitignore).

NEXT_PUBLIC_NETWORK=creditcoinTestnet

# WalletConnect Cloud project id — https://cloud.walletconnect.com
# Required for the WalletConnect connector; MetaMask/injected work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# PixelOrbit contracts on Creditcoin CC3 testnet (chain id 102031).
# Printed by `npm run --prefix contracts deploy:creditcoin`.
NEXT_PUBLIC_SHIP_CONTRACT_ADDRESS=
NEXT_PUBLIC_ITEM_CONTRACT_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ADDRESS=
NEXT_PUBLIC_LEADERBOARD_CONTRACT_ADDRESS=
NEXT_PUBLIC_STARS_ADDRESS=
NEXT_PUBLIC_ASC_ADDRESS=
# Attested Chainlink ETH/USD relay on Creditcoin CC3 (empty disables the sale
# banner; the dealership shows flat Stars prices). Printed after deploying
# PixelOrbitPriceOracle. Stars has no market price — this relay gates the
# 20 percent flash sale only and never values Stars in USD.
NEXT_PUBLIC_PRICE_ORACLE_ADDRESS=

# Sepolia source lock (chainkey 1), printed by
# `npm run --prefix contracts deploy:sepolia`.
NEXT_PUBLIC_SOURCE_ADDRESS=

# Dual Stars sale doors (empty disables the Buy Stars panels with a reason).
# NEXT_PUBLIC_SALE_ADDRESS — Sepolia StarsSale (ETH door), printed by
#   deploy-stars-sale.ts.
# NEXT_PUBLIC_CC_SALE_ADDRESS — Creditcoin StarsSaleCC3 (tCTC door),
#   printed by deploy-cc3-sale.ts.
NEXT_PUBLIC_SALE_ADDRESS=
NEXT_PUBLIC_CC_SALE_ADDRESS=
# Sepolia Stars token. OPTIONAL — leave empty and the bridge derives it at
# runtime from PixelOrbitSource.stars(). deploy-sepolia-source.ts does not
# print it, so deriving is the default path, not a fallback.
NEXT_PUBLIC_SEPOLIA_STARS_ADDRESS=

# Browser-reachable Sepolia RPC for lock receipts and token reads.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Attestcoin readability endpoints.
# PROVER_URL builds Merkle plus continuity proofs for Sepolia locks;
# DASHBOARD_URL tracks the bridge transactions.
NEXT_PUBLIC_PROVER_URL=https://prover.cc3-testnet.creditcoin.network/
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.cc3-testnet.creditcoin.network/

# Sepolia RPC for reading the source lock contract.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Server-only run-token signer for /api/game/start (message signing only:
# never sends transactions, needs no funds, has no on-chain role). Generate
# with: node -e "console.log('0x'+require('node:crypto').randomBytes(32).toString('hex'))"
# NEVER prefix with NEXT_PUBLIC_ — that would ship the key to browsers.
# Missing key = every game-over toasts "Score attestation is not configured".
SCORE_SIGNER_KEY=
